node_modules/

# Build output
#
# lib/ stays out of the checkout: no install path runs a lifecycle script
# (pnpm runs none for a `file:` directory dep and blocks git-hosted builds
# behind allowBuilds), so a build is an explicit step — `pnpm build`, then
# `dsh plugin add file:<repo>`. `pnpm verify` builds before it tests.
/lib/

legacy/agent/.gotmp/

